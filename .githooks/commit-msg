#!/bin/sh
# Local Conventional Commits gate, mirrors the commitlint job in
# .github/workflows/ci.yml so a bad message is caught before it is pushed,
# not only on the PR. Enable once per clone: git config core.hooksPath .githooks
set -eu

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/_.-]+\))?(!)?: .+'
subject=$(head -n1 "$1")

case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;; # git-generated subjects, not authored by hand
esac

if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  echo "commit-msg: not Conventional Commits: '$subject'" >&2
  echo "commit-msg: want type(scope): subject, type one of feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
  exit 1
fi
